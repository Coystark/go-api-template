DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app
DB_SSLMODE=disable

REDIS_ADDR=localhost:6379

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRATION=24h

APP_PORT=8080
LOG_LEVEL=info

# Opcional: desliga logs SQL verbosos do GORM
GORM_DEBUG=false

# Timeout para shutdown HTTP/worker
SHUTDOWN_TIMEOUT=10s
